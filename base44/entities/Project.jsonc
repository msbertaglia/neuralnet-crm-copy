{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "concluido",
        "pausado",
        "cancelado"
      ],
      "default": "ativo"
    },
    "contact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contact_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "color": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}